digraph ERD {
  graph [fontname="Inter", bgcolor="white", pad=0.35, splines=spline, newrank=true];
  node  [shape=plain, fontname="Inter", fontsize=13, fontcolor="#0F172A"];
  edge  [fontname="Inter", fontsize=10, color="#64748B", fontcolor="#475569", penwidth=1.6, arrowsize=0.75];
  graph [rankdir=TB, nodesep=0.9, ranksep=0.7];
  edge [arrowhead=crow, arrowtail=tee, dir=both, color="#15803D", fontcolor="#15803D", fontsize=11];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#15803D" bgcolor="white"><tr><td colspan="2" bgcolor="#15803D" align="left"><font color="white"><b>users</b></font></td></tr><tr><td align="left" width="26"><font color="#B45309" point-size="10"><b>PK</b></font></td><td align="left"><font point-size="11" color="#0F172A">_id</font></td></tr><tr><td align="left" width="26"><font color="#0F766E" point-size="10"><b>UQ</b></font></td><td align="left"><font point-size="11" color="#0F172A">username</font></td></tr><tr><td align="left" width="26"><font color="#0F766E" point-size="10"><b>UQ</b></font></td><td align="left"><font point-size="11" color="#0F172A">email</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">passwordHash (bcrypt)</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">hasPassword</font></td></tr><tr><td align="left" width="26"><font color="#0F766E" point-size="10"><b>UQ</b></font></td><td align="left"><font point-size="11" color="#0F172A">googleId</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">passwordChangedAt</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">createdAt</font></td></tr></table>>];
  resumes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#15803D" bgcolor="white"><tr><td colspan="2" bgcolor="#15803D" align="left"><font color="white"><b>resumes</b></font></td></tr><tr><td align="left" width="26"><font color="#B45309" point-size="10"><b>PK</b></font></td><td align="left"><font point-size="11" color="#0F172A">_id</font></td></tr><tr><td align="left" width="26"><font color="#4F46E5" point-size="10"><b>FK</b></font></td><td align="left"><font point-size="11" color="#0F172A">userId</font></td></tr><tr><td align="left" width="26"><font color="#4F46E5" point-size="10"><b>FK</b></font></td><td align="left"><font point-size="11" color="#0F172A">fileId → GridFS</font></td></tr><tr><td align="left" width="26"><font color="#4F46E5" point-size="10"><b>FK</b></font></td><td align="left"><font point-size="11" color="#0F172A">imageId → GridFS</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">originalName</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">fileSize</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">uploadDate</font></td></tr></table>>];
  analyses [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#15803D" bgcolor="white"><tr><td colspan="2" bgcolor="#15803D" align="left"><font color="white"><b>analyses</b></font></td></tr><tr><td align="left" width="26"><font color="#B45309" point-size="10"><b>PK</b></font></td><td align="left"><font point-size="11" color="#0F172A">_id</font></td></tr><tr><td align="left" width="26"><font color="#4F46E5" point-size="10"><b>FK</b></font></td><td align="left"><font point-size="11" color="#0F172A">resumeId</font></td></tr><tr><td align="left" width="26"><font color="#4F46E5" point-size="10"><b>FK</b></font></td><td align="left"><font point-size="11" color="#0F172A">userId</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">companyName · jobTitle</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">jobDescription</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">feedback { overallScore, ATS,</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">  toneAndStyle, content,</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">  structure, skills }</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">createdAt</font></td></tr></table>>];
  improved [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#15803D" bgcolor="white"><tr><td colspan="2" bgcolor="#15803D" align="left"><font color="white"><b>improvedresumes</b></font></td></tr><tr><td align="left" width="26"><font color="#B45309" point-size="10"><b>PK</b></font></td><td align="left"><font point-size="11" color="#0F172A">_id</font></td></tr><tr><td align="left" width="26"><font color="#0F766E" point-size="10"><b>UQ</b></font></td><td align="left"><font point-size="11" color="#0F172A">analysisId (FK)</font></td></tr><tr><td align="left" width="26"><font color="#4F46E5" point-size="10"><b>FK</b></font></td><td align="left"><font point-size="11" color="#0F172A">resumeId · userId</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">europassCv · editedCv</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">changes [ ]</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">afterFeedback · scoredAt</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">createdAt</font></td></tr></table>>];
  letters [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#15803D" bgcolor="white"><tr><td colspan="2" bgcolor="#15803D" align="left"><font color="white"><b>coverletters</b></font></td></tr><tr><td align="left" width="26"><font color="#B45309" point-size="10"><b>PK</b></font></td><td align="left"><font point-size="11" color="#0F172A">_id</font></td></tr><tr><td align="left" width="26"><font color="#0F766E" point-size="10"><b>UQ</b></font></td><td align="left"><font point-size="11" color="#0F172A">improvedResumeId (FK)</font></td></tr><tr><td align="left" width="26"><font color="#0F766E" point-size="10"><b>UQ</b></font></td><td align="left"><font point-size="11" color="#0F172A">analysisId (FK)</font></td></tr><tr><td align="left" width="26"><font color="#4F46E5" point-size="10"><b>FK</b></font></td><td align="left"><font point-size="11" color="#0F172A">userId</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">inputs { name, address,</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">  source, tone }</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">letter · editedText</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">createdAt · updatedAt</font></td></tr></table>>];
  gridfs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155" bgcolor="white"><tr><td colspan="2" bgcolor="#334155" align="left"><font color="white"><b>GridFS  uploads.files / chunks</b></font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">PDF and PNG bytes</font></td></tr><tr><td align="left" width="26"></td><td align="left"><font point-size="11" color="#0F172A">255 KB chunks</font></td></tr></table>>];
  users -> resumes [label="1 : N"];
  resumes -> analyses [label="1 : N"];
  analyses -> improved [label="1 : 0..1", arrowhead=teeodot];
  letters -> improved [label="1 : 0..1", arrowtail=teeodot, arrowhead=tee, dir=both];
  resumes -> gridfs [label=" files", style=dashed, color="#334155", fontcolor="#334155", arrowhead=normal, arrowtail=none];
  {rank=same; users; resumes; analyses;}
  {rank=same; gridfs; letters; improved;}
}