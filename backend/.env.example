# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit the real .env file — it contains secrets.

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Put the database name before the "?"
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resumind?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: OAuth Client ID for "Sign in with Google" (Google Cloud Console → Credentials → OAuth client ID,
# type "Web application"). Must match VITE_GOOGLE_CLIENT_ID in frontend/.env. Empty = Google login turned off.
GOOGLE_CLIENT_ID=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: which Gemini model to use. Each model has its own free daily quota —
# if you see "free daily AI quota is used up", switch to gemini-flash-lite-latest (bigger free quota, faster).
GEMINI_MODEL=gemini-flash-latest

# Frontend URL allowed by CORS (comma-separated if more than one)
CLIENT_URL=http://localhost:5173

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=10

# Only behind a reverse proxy (Render: 1). Leave 0 locally and in Docker.
TRUST_PROXY=0
